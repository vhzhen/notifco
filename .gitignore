# Binaries
/bin/
/dist/
# Anchored to the repo root on purpose. An unanchored `notifco` also matches the
# cmd/notifco PACKAGE DIRECTORY, which silently excluded the entrypoint from
# every commit and left the published repo unable to build.
/notifco
*.exe
*.dll
*.so
*.dylib

# Test & coverage
*.test
*.out
coverage.*
/test/load/results/

# Environment & secrets — never commit UW_API_KEY or DISCORD_TOKEN
.env
.env.*
!.env.sample
*.pem
*.key

# Go workspace
go.work
go.work.sum
/vendor/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Load test output
load-results.txt
