# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.sample .env

# --- Discord ---
DISCORD_TOKEN=
DISCORD_APP_ID=
# DISCORD_GUILD_ID is for DEVELOPMENT ONLY. Setting it registers slash commands
# to that one server, where they appear instantly -- but they will NOT exist in
# any other server, so a publicly invited bot looks completely broken.
# Leave it EMPTY for a public bot: commands then register globally, and newly
# joined servers also get an instant copy.
DISCORD_GUILD_ID=

# --- UW Open Data API v3 ---
# Register a key (returns it immediately in the JSON body, no email confirmation):
#   curl --request POST \
#     --url https://openapi.data.uwaterloo.ca/v3/account/register \
#     --header 'content-type: application/x-www-form-urlencoded' \
#     --data 'email=YOU@example.com&project=notifco&uri=https%3A%2F%2Fgithub.com%2Fvhzhen%2Fnotifco'
# Leave UW_API_KEY empty to run against the mock source (fixtures in
# internal/source/testdata). That is what CI does.
UW_API_KEY=
NOTIFCO_SOURCE=mock          # uwapi | mock

# Reserve notes ("Reserve: Year 1 students") are NOT in the Open Data API. They come
# from UW's public Schedule of Classes web page, a SECOND upstream with no published
# terms. Used only on demand, one request per course, rate limited and cached.
# Set to false to disable it. Always off with the mock source.
NOTIFCO_SCHEDULE_NOTES=true

# --- Storage ---
DATABASE_URL=postgres://notifco:notifco@localhost:5432/notifco?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Lower on small hosts: each Postgres backend costs memory. 6 suits a 1 GB VM.
NOTIFCO_DB_MAX_CONNS=16

# --- Poller ---
NOTIFCO_POLL_INTERVAL=60s
NOTIFCO_HOT_INTERVAL=15s
NOTIFCO_HOT_MAX=50
NOTIFCO_POLL_WORKERS=4
# Upstream requests per minute.
#
# UW documents 120/min. Measured against the live API: 150 requests in 22s
# (~409/min) and 400 requests in 90s (~266/min sustained), both with zero 429s.
# So the documented figure is not what is currently enforced.
#
# The default stays at the documented 120 on purpose: this is a public project
# and shipping a default that exceeds a documented limit is not defensible for
# everyone who self-hosts. Raise it on YOUR instance if you need more watched
# courses (roughly: supported courses = rate limit, at a 60s interval).
#
# Raising it is reasonably safe because the client is adaptive: a 429 halves
# the effective rate immediately and sustained success walks it back up, so if
# UW tightens enforcement notifco self-corrects instead of hammering.
NOTIFCO_RATE_LIMIT=120

# --- Notifier ---
NOTIFCO_NOTIFY_WORKERS=8
NOTIFCO_COOLDOWN=30m
NOTIFCO_MAX_ATTEMPTS=6

# --- Ops ---
METRICS_ADDR=:9090
LOG_LEVEL=info
