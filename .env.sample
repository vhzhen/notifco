# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.sample .env

# --- Discord ---
DISCORD_TOKEN=
DISCORD_APP_ID=

# --- UW Open Data API v3 ---
# Register a key (returns it immediately in the JSON body, no email confirmation):
#   curl --request POST \
#     --url https://openapi.data.uwaterloo.ca/v3/account/register \
#     --header 'content-type: application/x-www-form-urlencoded' \
#     --data 'email=YOU@example.com&project=notifco&uri=https%3A%2F%2Fgithub.com%2Fvhzhen%2Fnotifco'
# Leave UW_API_KEY empty to run against the mock source (fixtures in
# internal/source/testdata). That is what CI does.
UW_API_KEY=
NOTIFCO_SOURCE=mock          # uwapi | mock

# --- Storage ---
DATABASE_URL=postgres://notifco:notifco@localhost:5432/notifco?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Lower on small hosts: each Postgres backend costs memory. 6 suits a 1 GB VM.
NOTIFCO_DB_MAX_CONNS=16

# --- Poller ---
NOTIFCO_POLL_INTERVAL=60s
NOTIFCO_HOT_INTERVAL=15s
NOTIFCO_HOT_MAX=50
NOTIFCO_POLL_WORKERS=4
# Documented cap is 120 req/min. ~409/min was observed without a 429, but the docs call
# the limit experimental and send no rate-limit headers, so treat that as margin.
NOTIFCO_RATE_LIMIT=120

# --- Notifier ---
NOTIFCO_NOTIFY_WORKERS=8
NOTIFCO_COOLDOWN=30m
NOTIFCO_MAX_ATTEMPTS=6

# --- Ops ---
METRICS_ADDR=:9090
LOG_LEVEL=info
